APP_ENV=development

API_HOST=0.0.0.0
API_PORT=8000

VITE_API_BASE_URL=http://localhost:8000

AI_PROVIDER=mock

AWS_REGION=
AWS_PROFILE=
BEDROCK_MODEL_ID=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# AI Risk Committee roster — one seat per lens, different labs on purpose.
# Override any seat if a model id changes or a provider is unavailable.
COMMITTEE_MACRO_MODEL=openai/gpt-6.1-sol
COMMITTEE_SECTOR_MODEL=~google/gemini-pro-latest
COMMITTEE_CROSS_ASSET_MODEL=moonshotai/kimi-k3
COMMITTEE_CHAIR_MODEL=anthropic/claude-opus-5.5

ENABLE_POLYMARKET=false
ENABLE_NEWS=false

NEWS_API_KEY=

# true = serve cached Polymarket snapshots only, no external calls. The
# final-demo setting; run scripts/snapshot_polymarket.py first.
DEMO_MODE=false

POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com

# Optional outbound proxy for the API's HTTPS calls (OpenRouter, Polymarket).
# Needed when the server's IP is region-blocked by OpenRouter.
HTTPS_PROXY=
